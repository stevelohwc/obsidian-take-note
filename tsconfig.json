{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    "allowJs": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "importHelpers": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["DOM", "ES2022"]
  },
  "include": ["src/**/*.ts"]
}
